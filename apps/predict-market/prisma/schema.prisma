// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  address String @unique
  usd_balance Int
  position Position[]
  orders OrderHistory[]
}

model Market {
  id String @id @default(uuid())
  title String 
  description String
  resolutionDescription String // description on how market is resolved
  yes_ord Json
  no_ord Json
  totalQty Int
  position Position[]
  orders OrderHistory[]
  resolution PositionType?
}

model Position {
  id String @id @default(uuid())
  userID String 
  marketID String
  type PositionType
  user User @relation(fields: [userID], references: [id])
  market Market @relation(fields: [marketID], references: [id])
  qty Int
  @@unique([userID, marketID, type])
}

model OrderHistory {
  id String @id @default(uuid())
  order OrderType 
  qty Int
  price Int
  userId String
  marketId String
  user User @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
}

enum OrderType {
  buy
  split
  sell
  merge
}

enum PositionType {
  yes 
  no
}
